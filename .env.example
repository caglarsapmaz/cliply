# --- Conversion engine (server-only, required for real downloads) ---
# Cliply doesn't run its own extraction/conversion — that's CPU/time heavy
# and doesn't fit Vercel's serverless model. It talks to a Cobalt
# (https://github.com/imputnet/cobalt) instance instead: self-host one
# (a single Docker container) or point at a trusted public instance from
# https://instances.cobalt.best. Without this set, /api/convert returns a
# clear 503 instead of faking a result.
COBALT_API_URL=
# Only needed if your instance requires it (most self-hosted ones don't).
COBALT_API_KEY=

# --- Richer metadata (optional) ---
# Without this, Cliply still shows title + thumbnail via YouTube's public
# oEmbed endpoint, just without an exact duration.
# Get a free key at https://console.cloud.google.com (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# --- Rate limiting (optional but recommended in production) ---
# Free tier at https://upstash.com. Without these, Cliply falls back to an
# in-memory limiter that only protects a single running instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site ---
# Used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
