# --- Conversion engine (optional tuning) ---
# yt-dlp + ffmpeg are baked into the Docker image and run in-process, so no
# URL/key is needed here. These two just cap how much load a single small
# instance takes on.
# Max number of yt-dlp conversions allowed to run at the same time. Extra
# requests get a clear "conversion_unavailable" instead of piling up.
MAX_CONCURRENT_JOBS=2
# Kills a stuck/runaway yt-dlp process after this many milliseconds.
YTDLP_TIMEOUT_MS=120000

# --- Richer metadata (optional) ---
# Without this, Cliply still shows title + thumbnail via YouTube's public
# oEmbed endpoint, just without an exact duration.
# Get a free key at https://console.cloud.google.com (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# --- Rate limiting (optional but recommended in production) ---
# Free tier at https://upstash.com. Without these, Cliply falls back to an
# in-memory limiter that only protects a single running instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site ---
# Used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
